{% extends "_base.html.j2" %}
{% block content %}
<div class="card-wrap">
  <div class="card info">
    <div class="eyebrow">Anhang {{ index }} &middot; Original</div>
    <div class="title">{{ filename }}</div>
    <div class="explain">{{ reason }}</div>
    {% if embedded %}
    <div class="explain">Die Originaldatei ist in dieses PDF eingebettet (Anhänge des PDF-Programms) und zusätzlich in der eingebetteten E-Mail {{ eml_name }} enthalten.</div>
    {% else %}
    <div class="explain">Die Originaldatei ist in der eingebetteten E-Mail {{ eml_name }} enthalten.</div>
    {% endif %}
    <div class="meta">{{ mime }} &middot; {{ size }}</div>
  </div>
</div>
{% endblock %}
